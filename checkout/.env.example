# Secret API key for the Stripe account that should receive the payments.
# Dashboard -> Developers -> API keys. Never commit the real value.
STRIPE_SECRET_KEY=

# Signing secret of the webhook endpoint that receives checkout.session.completed.
# Dashboard -> Developers -> Webhooks -> (endpoint) -> Signing secret,
# or the whsec_... value printed by `stripe listen`.
STRIPE_WEBHOOK_SECRET=

# Publishable key. Not needed by this service (Checkout is hosted by Stripe);
# only set it if a front end on the same deployment needs it.
# Dashboard -> Developers -> API keys.
STRIPE_PUBLISHABLE_KEY=

# Port the checkout service listens on.
PORT=4242

# Origin the buyer is returned to after checkout. Used to build the default
# success and cancel URLs.
PUBLIC_BASE_URL=http://localhost:4242

# Optional explicit overrides for the return URLs. {CHECKOUT_SESSION_ID} is
# substituted by Stripe on the success URL.
# CHECKOUT_SUCCESS_URL=https://example.com/order/complete?session_id={CHECKOUT_SESSION_ID}
# CHECKOUT_CANCEL_URL=https://example.com/order/cancelled

# Directory holding the catalog and order records.
# CHECKOUT_DATA_DIR=./data
